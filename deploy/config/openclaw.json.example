{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_YOUR_GATEWAY_TOKEN"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://YOUR_HOSTNAME:18789",
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ],
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/YOUR_USER/.openclaw/workspace",
      "model": {
        "primary": "vllm/qwen-local"
      },
      "models": {
        "vllm/qwen-local": {
          "params": {
            "maxTokens": 900
          }
        }
      }
    },
    "list": [
      {
        "id": "main"
      },
      {
        "id": "localqwen",
        "name": "localqwen",
        "workspace": "/home/YOUR_USER/.openclaw/workspace-localqwen",
        "agentDir": "/home/YOUR_USER/.openclaw/agents/localqwen/agent",
        "model": "vllm/qwen-local"
      }
    ]
  },
  "plugins": {
    "entries": {
      "vllm": {
        "enabled": true
      }
    }
  },
  "tools": {
    "media": {
      "audio": {
        "enabled": true,
        "maxBytes": 20971520,
        "models": [
          {
            "type": "cli",
            "command": "/home/YOUR_USER/.openclaw/bin/fw-whisper",
            "args": [
              "{{MediaPath}}"
            ],
            "timeoutSeconds": 300
          }
        ]
      }
    }
  },
  "messages": {
    "tts": {
      "providers": {
        "openai": {
          "apiKey": "local-not-used",
          "baseUrl": "http://127.0.0.1:8188/v1",
          "model": "cosyvoice-v3",
          "responseFormat": "wav"
        }
      }
    }
  }
}
