[Unit]
Description=CosyVoice Local TTS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OPENCLAW_HOME=/home/YOUR_USER/.openclaw
Environment=OPENCLAW_PYTHON=/path/to/python
ExecStart=/path/to/python /home/YOUR_USER/.openclaw/cosyvoice/tts_server.py
Restart=always
RestartSec=5
Environment=COSYVOICE_TTS_PORT=9461
Environment=COSYVOICE_TTS_MODEL_DIR=/home/YOUR_USER/.openclaw/cosyvoice/models/CosyVoice-300M-SFT
Environment=COSYVOICE_TTS_SPEAKER=中文女
Environment=COSYVOICE_TTS_OUT_DIR=/home/YOUR_USER/.openclaw/cosyvoice/tts-out
Environment=COSYVOICE_ROOT=/home/YOUR_USER/.openclaw/cosyvoice/CosyVoice
Environment=COSYVOICE_PYDEPS=/home/YOUR_USER/.openclaw/cosyvoice-pydeps
Environment=PYTHONPATH=/home/YOUR_USER/.openclaw/cosyvoice-pydeps:/home/YOUR_USER/.openclaw/cosyvoice/CosyVoice:/home/YOUR_USER/.openclaw/cosyvoice/CosyVoice/third_party/Matcha-TTS

[Install]
WantedBy=default.target
