[Service]
Type=simple
ExecStart=/home/aa-3090/anaconda3/envs/torch290_cu128_py310/bin/python /home/aa-3090/.openclaw/sherpa-kws/server.py
Restart=always
RestartSec=5
Environment=SHERPA_KWS_PORT=9462
Environment=SHERPA_KWS_MODEL_DIR=/home/aa-3090/.openclaw/sherpa-kws/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
