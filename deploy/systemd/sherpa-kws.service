[Unit]
Description=Sherpa ONNX Local Wake Word Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OPENCLAW_HOME=/home/YOUR_USER/.openclaw
ExecStart=/path/to/python /home/YOUR_USER/.openclaw/sherpa-kws/server.py
Restart=always
RestartSec=5
Environment=SHERPA_KWS_PORT=9462
Environment=SHERPA_KWS_MODEL_DIR=/home/YOUR_USER/.openclaw/sherpa-kws/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
Environment=SHERPA_KWS_KEYWORDS_FILE=/home/YOUR_USER/.openclaw/sherpa-kws/wake_keywords.txt
Environment="SHERPA_KWS_TARGET_PHRASE=机器人你好"
Environment=SHERPA_KWS_PYDEPS=/home/YOUR_USER/.openclaw/sherpa-kws-pydeps
Environment=PYTHONPATH=/home/YOUR_USER/.openclaw/sherpa-kws-pydeps

[Install]
WantedBy=default.target
