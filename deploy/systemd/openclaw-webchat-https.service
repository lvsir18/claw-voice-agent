[Unit]
Description=OpenClaw Voice Web Chat HTTPS
After=network-online.target openclaw-webchat.service
Wants=network-online.target

[Service]
Type=simple
Environment=OPENCLAW_HOME=/home/YOUR_USER/.openclaw
ExecStart=/usr/bin/python3 /home/YOUR_USER/.openclaw/webchat/server.py
Restart=always
RestartSec=3
Environment=OPENCLAW_WEBCHAT_PORT=18443
Environment=OPENCLAW_WEBCHAT_AGENT=localqwen
Environment=OPENCLAW_BIN=/home/YOUR_USER/.openclaw/bin/openclaw
Environment=FW_WHISPER_BIN=/home/YOUR_USER/.openclaw/bin/fw-whisper
Environment=OPENCLAW_WEBCHAT_TLS_CERT=/home/YOUR_USER/.openclaw/webchat/certs/webchat.crt
Environment=OPENCLAW_WEBCHAT_TLS_KEY=/home/YOUR_USER/.openclaw/webchat/certs/webchat.key

[Install]
WantedBy=default.target
